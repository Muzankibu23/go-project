# ============================================================
# Go Project — URLs propres (Apache / cPanel)
# goproject.ma/contact  au lieu de  goproject.ma/contact.html
# ============================================================

RewriteEngine On

# --- 1. Forcer HTTPS -----------------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- 2. Supprimer le slash final -----------------------------------------
# Indispensable : les chemins relatifs (dont images/logo-on-energy.png)
# se résolvent depuis la racine tant qu'il n'y a pas de slash final.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# --- 3. Rediriger les anciennes URL .html vers l'URL propre --------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# index.html et accueil renvoient vers la racine
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteRule ^accueil/?$ / [R=301,L]

# Ancienne adresse avant renommage
RewriteRule ^apropos/?$ /a-propos [R=301,L]

# --- 4. Servir le .html correspondant ------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# --- 5. Page 404 ----------------------------------------------------------
ErrorDocument 404 /404.html

# --- 6. Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 7. Cache navigateur --------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html            "access plus 1 hour"
</IfModule>

# --- 8. En-têtes de sécurité ---------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- 9. Encodage ----------------------------------------------------------
AddDefaultCharset UTF-8
